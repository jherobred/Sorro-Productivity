<?xml version="1.0" encoding="utf-8"?>
<!--
  The same surface, at the radius this launcher actually masks widgets to.

  Android 12 rounds every widget itself, so a card with its own fixed corner
  sits inside a slightly different one and draws a second, thinner arc just
  inside the first. Asking the platform for its own number is the only way the
  two edges land on top of each other.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/bd_card" />
    <stroke android:width="1dp" android:color="@color/bd_line" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
