<?xml version="1.0" encoding="utf-8"?>
<!-- An action button. Outlined rather than filled: four filled buttons in a row
     is four things shouting, and the icon already carries the colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/bd_card2" />
    <stroke android:width="1dp" android:color="@color/bd_line2" />
    <corners android:radius="16dp" />
</shape>
