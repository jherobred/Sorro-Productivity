<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's design tokens, as Android resources.

  Mirrors app/globals.css :root (dark) and lib/pal.ts SECHUE. The widget is on
  the home screen next to the app icon, so a hue that drifts from the app reads
  as a different product. Values are copied, not approximated — the two `line`
  tokens are the only translation, because a widget drawable stroke cannot be an
  alpha over an unknown wallpaper, so they are flattened over the card colour.
-->
<resources>
    <color name="bd_bg">#0B0A13</color>
    <color name="bd_card">#16151F</color>
    <color name="bd_card2">#1F1D2A</color>
    <color name="bd_line">#232130</color>
    <color name="bd_line2">#332F42</color>
    <color name="bd_tx">#EFEDF5</color>
    <color name="bd_tx2">#A29EBB</color>
    <color name="bd_tx3">#78748F</color>
    <color name="bd_ink">#0B0A13</color>

    <!-- lib/pal.ts DEFAULT_ACCENT + SECHUE -->
    <color name="bd_acc">#8B7CFF</color>
    <color name="bd_tasks">#34D9A0</color>
    <color name="bd_fuel">#A3E635</color>
    <color name="bd_money">#34D9A0</color>
    <color name="bd_habits">#FF6B6B</color>
    <color name="bd_water">#38BDF8</color>
    <color name="bd_notes">#B07CFF</color>

    <string name="bd_today_label">Basedly · Today</string>
    <string name="bd_quick_label">Basedly · Quick log</string>
    <string name="bd_habits_label">Basedly · Habits</string>
    <string name="bd_today_desc">Your day at a glance, with one tap to log.</string>
    <string name="bd_quick_desc">Four buttons: water, task, expense, note.</string>
    <string name="bd_habits_desc">Tick today\'s habits from the home screen.</string>
</resources>
