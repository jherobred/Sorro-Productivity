<?xml version="1.0" encoding="utf-8"?>
<!--
  Draw into the display cutout.

  The base theme leaves the notch area as a black bar the app cannot paint, so a
  full-bleed screen still reads as a page inside a frame. `shortEdges` hands the
  cutout to the app; the Shell frame already pads itself by
  env(safe-area-inset-top), so nothing lands under the camera.

  This lives in values-v27 rather than values because the attribute only exists
  from API 27; older devices fall back to the base theme unchanged.
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
