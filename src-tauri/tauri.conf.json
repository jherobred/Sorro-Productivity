{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sorro",
  "version": "2.0.0",
  "identifier": "com.sorro.desktop",
  "build": {
    "frontendDist": "https://sorro-jhemsini.vercel.app",
    "devUrl": "https://sorro-jhemsini.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sorro",
        "decorations": false,
        "width": 1366,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sorro: notes, calendar and tasks"
  }
}